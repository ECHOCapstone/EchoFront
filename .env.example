# ECHO 프론트엔드 환경변수 템플릿. 실제 값은 .env / .env.production 에 복사해 채운다(둘 다 git 무시).

# 백엔드 API 의 절대 베이스 URL. 비워 두면 same-origin 으로 호출하며, 개발에서는 vite proxy 가
# /api 를 백엔드로 전달한다. 운영 빌드에서 백엔드가 다른 호스트면 절대 URL 을 지정한다.
# 예: https://api.echo.example.com
VITE_API_BASE_URL=

# (개발 전용) vite dev 서버가 /api·/actuator 를 프록시할 백엔드 주소. 미지정 시 http://localhost:8080.
# VITE_DEV_PROXY_TARGET=http://localhost:8080
